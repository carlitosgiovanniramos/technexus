---
interface Props {
  activeNav?: string;
  theme?: string;
}

const { activeNav = '' } = Astro.props;
---

<!-- TopNavBar (Always Dark Corporate Style) -->
<nav class="bg-surface/80 backdrop-blur-xl fixed top-0 w-full z-50 border-b border-outline-variant/10">
  <div class="grid grid-cols-[auto_1fr_auto] items-center px-margin-desktop py-4 max-w-container-max mx-auto">
    <a class="font-display-lg text-headline-sm font-bold tracking-tighter text-primary" href="/">TechNexus</a>
    <!-- Desktop Nav -->
    <ul class="hidden md:flex justify-self-center space-x-8">
      <li>
        <a
          data-nav-item="inicio"
          class={`nav-link font-body-md text-body-md font-medium transition-all duration-300 pb-1 border-b-2 ${
            activeNav === 'inicio' ? 'text-surface-tint border-surface-tint' : 'text-on-surface-variant hover:text-surface-tint border-transparent'
          }`}
          href="/"
        >
          Inicio
        </a>
      </li>
      <li>
        <a
          data-nav-item="servicios"
          class={`nav-link font-body-md text-body-md font-medium transition-all duration-300 pb-1 border-b-2 ${
            activeNav === 'servicios' ? 'text-surface-tint border-surface-tint' : 'text-on-surface-variant hover:text-surface-tint border-transparent'
          }`}
          href="/servicios#servicios"
        >
          Servicios
        </a>
      </li>
      <li>
        <a
          data-nav-item="nosotros"
          class={`nav-link font-body-md text-body-md font-medium transition-all duration-300 pb-1 border-b-2 ${
            activeNav === 'nosotros' ? 'text-surface-tint border-surface-tint' : 'text-on-surface-variant hover:text-surface-tint border-transparent'
          }`}
          href="/nosotros"
        >
          Nosotros
        </a>
      </li>
      <li>
        <a
          data-nav-item="blog"
          class={`nav-link font-body-md text-body-md font-medium transition-all duration-300 pb-1 border-b-2 ${
            activeNav === 'blog' ? 'text-surface-tint border-surface-tint' : 'text-on-surface-variant hover:text-surface-tint border-transparent'
          }`}
          href="/blog"
        >
          Blog
        </a>
      </li>
      <li>
        <a
          data-nav-item="contacto"
          class={`nav-link font-body-md text-body-md font-medium transition-all duration-300 pb-1 border-b-2 ${
            activeNav === 'contacto' ? 'text-surface-tint border-surface-tint' : 'text-on-surface-variant hover:text-surface-tint border-transparent'
          }`}
          href="/contacto"
        >
          Contacto
        </a>
      </li>
    </ul>
    <!-- Mobile Menu Button -->
    <button class="md:hidden justify-self-end text-primary" id="mobile-toggle" aria-label="Menu">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-surface border-b border-outline-variant/10 px-margin-desktop py-4">
    <ul class="flex flex-col space-y-3">
      <li><a class="block text-on-surface-variant hover:text-surface-tint py-1" href="/">Inicio</a></li>
      <li><a class="block text-on-surface-variant hover:text-surface-tint py-1" href="/servicios#servicios">Servicios</a></li>
      <li><a class="block text-on-surface-variant hover:text-surface-tint py-1" href="/nosotros">Nosotros</a></li>
      <li><a class="block text-on-surface-variant hover:text-surface-tint py-1" href="/blog">Blog</a></li>
      <li><a class="block text-on-surface-variant hover:text-surface-tint py-1" href="/contacto">Contacto</a></li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
