---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="TechNexus - Nosotros"
  description="En TechNexus desarrollamos soluciones de software modernas, escalables y seguras, combinando ingeniería e innovación."
  activeNav="nosotros"
>
  <main class="flex-grow pt-12 md:pt-16 pb-section-gap">
    <!-- =========================
         ENCABEZADO
         ========================= -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mb-6 md:mb-8">
      <div class="flex flex-col md:flex-row justify-between items-end gap-4 md:gap-stack-lg border-b border-outline-variant/20 pb-3 md:pb-4">
        <div class="max-w-xl">
          <p class="font-label-caps text-xs text-surface-tint mb-1.5 uppercase tracking-widest">
            Nosotros
          </p>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[38px] font-bold text-primary tracking-tight leading-tight">
            Nuestro Equipo de Expertos
          </h1>
        </div>

        <div class="max-w-md text-left">
          <p class="font-label-caps text-xs text-surface-tint mb-1.5 uppercase tracking-widest">
            Quiénes somos
          </p>
          <p class="font-body-md text-xs sm:text-[13.5px] text-on-surface-variant leading-relaxed">
            En TechNexus desarrollamos soluciones de software modernas,
            escalables y seguras, combinando ingeniería e innovación
            para transformar ideas en soluciones digitales eficientes.
          </p>
        </div>
      </div>
    </section>

    <!-- =========================
         EQUIPO
         ========================= -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mb-section-gap">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
        <!-- EVELYN -->
        <div class="team-card bg-surface-container rounded-lg border border-surface-container-highest group">
          <div class="relative h-56 sm:h-60 md:h-64 overflow-hidden rounded-t-lg">
            <img alt="Evelyn Cárdenas" class="w-full h-full object-cover team-image" src="/img/evelyn.png" />
          </div>
          <div class="card-info">
            <h3 class="text-base sm:text-lg font-semibold text-primary mb-0.5">
              Evelyn Cárdenas
            </h3>
            <p class="text-xs text-surface-tint mb-1 font-medium">
              Backend
            </p>
            <p class="text-xs sm:text-[12.5px] text-on-surface-variant card-description">
              Especialista en backend con <span class="text-white font-medium">.NET</span>, <span class="text-white font-medium">Spring Boot</span> y <span class="text-white font-medium">SQL</span> para arquitecturas robustas.
            </p>
          </div>
        </div>

        <!-- EDUARDO -->
        <div class="team-card bg-surface-container rounded-lg border border-surface-container-highest group">
          <div class="relative h-56 sm:h-60 md:h-64 overflow-hidden rounded-t-lg">
            <img alt="Eduardo Punina" class="w-full h-full object-cover team-image" src="/img/eduardo.png" />
          </div>
          <div class="card-info">
            <h3 class="text-base sm:text-lg font-semibold text-primary mb-0.5">
              Eduardo Punina
            </h3>
            <p class="text-xs text-surface-tint mb-1 font-medium">
              Frontend
            </p>
            <p class="text-xs sm:text-[12.5px] text-on-surface-variant card-description">
              Desarrollo frontend y diseño UI con <span class="text-white font-medium">HTML5</span>, <span class="text-white font-medium">Tailwind CSS</span> y <span class="text-white font-medium">JavaScript</span>.
            </p>
          </div>
        </div>

        <!-- CARLOS -->
        <div class="team-card bg-surface-container rounded-lg border border-surface-container-highest group">
          <div class="relative h-56 sm:h-60 md:h-64 overflow-hidden rounded-t-lg">
            <img alt="Carlos Ramos" class="w-full h-full object-cover team-image" src="/img/carlos.png" />
          </div>
          <div class="card-info">
            <h3 class="text-base sm:text-lg font-semibold text-primary mb-0.5">
              Carlos Ramos
            </h3>
            <p class="text-xs text-surface-tint mb-1 font-medium">
              Full Stack
            </p>
            <p class="text-xs sm:text-[12.5px] text-on-surface-variant card-description">
              Desarrollo Full Stack y móvil con <span class="text-white font-medium">Flutter</span>, <span class="text-white font-medium">Swift</span> y tecnologías web modernas.
            </p>
          </div>
        </div>

        <!-- VIVIANA -->
        <div class="team-card bg-surface-container rounded-lg border border-surface-container-highest group">
          <div class="relative h-56 sm:h-60 md:h-64 overflow-hidden rounded-t-lg">
            <img alt="Viviana Sarco" class="w-full h-full object-cover team-image" src="/img/viviana.png" />
          </div>
          <div class="card-info">
            <h3 class="text-base sm:text-lg font-semibold text-primary mb-0.5">
              Viviana Sarco
            </h3>
            <p class="text-xs text-surface-tint mb-1 font-medium">
              Backend
            </p>
            <p class="text-xs sm:text-[12.5px] text-on-surface-variant card-description">
              Desarrollo backend y servicios web con <span class="text-white font-medium">Java</span>,
              <span class="text-white font-medium">C#</span>, <span class="text-white font-medium">PHP</span> y bases de datos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         PROYECTOS
         ========================= -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mb-section-gap">
      <!-- TITULO -->
      <div class="flex flex-col md:flex-row justify-between items-end gap-stack-lg border-b border-outline-variant/20 pb-8 mb-10">
        <div>
          <p class="font-label-caps text-label-caps text-surface-tint mb-4 uppercase tracking-widest">
            Proyectos
          </p>
          <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary">
            Proyectos Destacados
          </h2>
        </div>
        <p class="max-w-md font-body-lg text-body-lg text-on-surface-variant">
          Soluciones digitales creadas para resolver necesidades
          reales mediante tecnología, innovación y diseño.
        </p>
      </div>

      <!-- TARJETAS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <!-- PROYECTO 1 -->
        <div class="project-card bg-surface-container rounded-xl border border-surface-container-highest">
          <div class="h-56 overflow-hidden">
            <img src="/img/proyecto-1.jpg" alt="Sistema de Gestión Empresarial" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <p class="font-label-caps text-label-caps text-surface-tint mb-3">
              Desarrollo Web
            </p>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-3">
              Sistema de Gestión Empresarial
            </h3>
            <p class="font-body-md text-[14px] text-on-surface-variant">
              Plataforma diseñada para facilitar la gestión
              de procesos, información y recursos de una empresa
              desde un solo sistema.
            </p>
          </div>
        </div>

        <!-- PROYECTO 2 -->
        <div class="project-card bg-surface-container rounded-xl border border-surface-container-highest">
          <div class="h-56 overflow-hidden">
            <img src="/img/proyecto-2.jpg" alt="Plataforma de Comercio Digital" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <p class="font-label-caps text-label-caps text-surface-tint mb-3">
              E-Commerce
            </p>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-3">
              Plataforma de Comercio Digital
            </h3>
            <p class="font-body-md text-[14px] text-on-surface-variant">
              Solución digital para administrar productos,
              clientes y ventas, ofreciendo una experiencia
              sencilla y moderna para los usuarios.
            </p>
          </div>
        </div>

        <!-- PROYECTO 3 -->
        <div class="project-card bg-surface-container rounded-xl border border-surface-container-highest">
          <div class="h-56 overflow-hidden">
            <img src="/img/proyecto-3.png" alt="Aplicación Móvil de Servicios" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <p class="font-label-caps text-label-caps text-surface-tint mb-3">
              Aplicación Móvil
            </p>
            <h3 class="font-headline-sm text-headline-sm text-primary mb-3">
              Aplicación Móvil de Servicios
            </h3>
            <p class="font-body-md text-[14px] text-on-surface-variant">
              Aplicación móvil creada para facilitar el acceso
              a servicios y funcionalidades desde cualquier
              dispositivo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         MISIÓN Y VISIÓN
         ========================= -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mb-section-gap">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-lg">
        <!-- MISIÓN -->
        <div class="glass-panel about-panel rounded-xl border border-outline-variant/20 overflow-hidden">
          <div class="h-64 overflow-hidden">
            <img src="/img/mision.jpg" alt="Misión de TechNexus" class="about-image" />
          </div>
          <div class="p-8 md:p-10">
            <h2 class="font-label-caps text-label-caps text-surface-tint mb-4 uppercase tracking-widest">
              Misión
            </h2>
            <h3 class="font-headline-md text-headline-md text-primary mb-6">
              Ingeniería de Alto Rendimiento
            </h3>
            <p class="font-body-lg text-body-lg text-on-surface-variant">
              Empoderar a las empresas globales mediante la
              ingeniería de infraestructuras digitales robustas,
              escalables y seguras. Cerramos la brecha entre los
              sistemas corporativos heredados y la transformación
              tecnológica de vanguardia, ofreciendo un rendimiento
              sin compromisos a través de la precisión y la innovación.
            </p>
          </div>
        </div>

        <!-- VISIÓN -->
        <div class="glass-panel about-panel rounded-xl border border-outline-variant/20 overflow-hidden">
          <div class="h-64 overflow-hidden">
            <img src="/img/vision.jpg" alt="Visión de TechNexus" class="about-image" />
          </div>
          <div class="p-8 md:p-10">
            <h2 class="font-label-caps text-label-caps text-surface-tint mb-4 uppercase tracking-widest">
              Visión
            </h2>
            <h3 class="font-headline-md text-headline-md text-primary mb-6">
              Escala Infinita
            </h3>
            <p class="font-body-lg text-body-lg text-on-surface-variant">
              Ser la base arquitectónica indiscutible para la
              próxima generación de empresas digitales.
              Visualizamos un futuro donde los desafíos técnicos
              complejos se resuelvan con soluciones elegantes y
              de escala infinita, estableciendo un centro de
              mando de eficiencia para empresas de todo el mundo.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================
         CIERRE
         ========================= -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="glass-panel p-12 md:p-24 rounded-xl relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('/img/proyecto-1.jpg')] bg-cover bg-center opacity-10 mix-blend-overlay" data-alt="Fondo tecnológico de TechNexus"></div>
        <div class="relative z-10 max-w-3xl">
          <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary mb-6">
            Construyendo la
            <br />
            <span class="text-surface-tint">
              Infraestructura del Mañana
            </span>
          </h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-8">
            En TechNexus, no solo escribimos código; diseñamos
            sistemas resilientes que impulsan la transformación
            digital. Nuestra visión es empoderar a las empresas
            a través de arquitectura de software robusta,
            escalable y segura, preparándolas para los desafíos
            tecnológicos del futuro.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =========================
     TARJETAS DEL EQUIPO
     ========================= */
  .team-card {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .team-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(18, 20, 20, 1) 0%,
      rgba(18, 20, 20, 0.95) 28%,
      rgba(18, 20, 20, 0.50) 52%,
      rgba(18, 20, 20, 0.72) 72%
    );
    z-index: 10;
    pointer-events: none;
  }

  .team-image {
    filter: grayscale(100%) contrast(1.2);
    transition: all 0.5s ease;
  }

  .team-card:hover .team-image {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.05);
  }

  .team-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -10px rgba(171, 214, 0, 0.12);
    border-color: rgba(171, 214, 0, 0.35);
  }

  .team-card .card-info {
    position: relative;
    z-index: 20;
    padding: 16px;
    margin-top: -95px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .team-card .card-description {
    line-height: 1.4;
  }

  /* =========================
     TARJETAS DE PROYECTOS
     ========================= */
  .project-card {
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .project-card img {
    transition: transform 0.5s ease;
  }

  .project-card:hover img {
    transform: scale(1.05);
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: rgba(171, 214, 0, 0.35);
    box-shadow: 0 18px 35px -10px rgba(171, 214, 0, 0.10);
  }

  /* =========================
     MISION Y VISION
     ========================= */
  .about-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.5s ease;
  }

  .about-panel:hover .about-image {
    transform: scale(1.04);
  }

  .about-panel {
    overflow: hidden;
  }

  /* =========================
     OTROS ESTILOS
     ========================= */
  .neon-accent {
    color: #abd600;
  }

  .glass-panel {
    background: rgba(18, 20, 20, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(68, 73, 51, 0.2);
  }
</style>
