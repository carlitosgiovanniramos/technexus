   MEJORA DEL CONTENIDO DE LAS TARJETAS
========================================= */

:global(.blog-feature-card h3) {
    margin-top: 0.7rem;
    margin-bottom: 0.6rem;
}

:global(.blog-feature-card p) {
    margin-bottom: 0;
}


/* =========================================
   ACCESIBILIDAD
========================================= */

@media (prefers-reduced-motion: reduce) {

    :global(.blog-reveal),
    :global(.blog-feature-card),
    :global(.blog-feature-icon) {
        transition: none;
        transform: none;
    }

    :global(.blog-reveal) {
        opacity: 1;
    }
}
</style>

<script>
  // Image Modal
  const modal = document.getElementById('image-modal');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const sketchItems = document.querySelectorAll('.sketch-item');

  sketchItems.forEach((item) => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src') || '';
      if (modal && modalImg) {
        modalImg.src = src;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    });
  });

  if (modal) {
    modal.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });
  }

  // Switch Role View (Admin vs Cliente)
  const tabAdmin = document.getElementById('tab-btn-admin');
  const tabCliente = document.getElementById('tab-btn-cliente');
  const iframe = document.getElementById('prototype-iframe') as HTMLIFrameElement;
  const resetBtn = document.getElementById('btn-reset-proto');

  tabAdmin?.addEventListener('click', () => {
    tabAdmin.classList.add('bg-primary-container', 'text-on-primary-fixed', 'shadow-sm');
    tabCliente?.classList.remove('bg-emerald-500', 'text-slate-950', 'shadow-sm');
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.postMessage({ action: 'NAVIGATE', screenId: 'screen-productos' }, '*');
    }
  });

  tabCliente?.addEventListener('click', () => {
    tabCliente.classList.add('bg-emerald-500', 'text-slate-950', 'shadow-sm');
    tabAdmin?.classList.remove('bg-primary-container', 'text-on-primary-fixed', 'shadow-sm');
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.postMessage({ action: 'NAVIGATE', screenId: 'screen-cliente-catalogo' }, '*');
    }
  });

  // Reset prototype
  if (resetBtn && iframe) {
    resetBtn.addEventListener('click', () => {
      iframe.src = iframe.src;
    });
  }

  function initBlogReveal() {

    const revealElements =
        document.querySelectorAll('.blog-reveal');

    if (!revealElements.length) return;

    const revealObserver = new IntersectionObserver(
        (entries) => {

            entries.forEach((entry) => {

                if (entry.isIntersecting) {

                    entry.target.classList.add('is-visible');

                    revealObserver.unobserve(entry.target);

                }

            });

        },
        {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px"
        }
    );

    revealElements.forEach((element) => {
        revealObserver.observe(element);
    });

}


/* Primera carga */
initBlogReveal();


/* Navegación interna de Astro */
document.addEventListener(
    'astro:page-load',
    initBlogReveal
);
</script>
