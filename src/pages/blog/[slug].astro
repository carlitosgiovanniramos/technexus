  }

  /* =========================================
   ANIMACIONES PARA CONTENIDO DEL BLOG
========================================= */

:global(.blog-reveal) {
    opacity: 0;
    transform: translateY(35px);

    transition:
        opacity 0.75s ease,
        transform 0.75s ease;
}

:global(.blog-reveal.is-visible) {
    opacity: 1;
    transform: translateY(0);
}


/* =========================================
   TARJETAS DEL CONTENIDO ACADÉMICO
========================================= */

:global(.blog-feature-card) {
    position: relative;
    overflow: hidden;

    border: 1px solid #e5e7eb;
    border-radius: 16px;

    background: #ffffff;

    padding: 1.4rem;

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
}


/* Línea verde animada */

:global(.blog-feature-card::before) {
    content: "";

    position: absolute;
    top: 0;
    left: 0;

    width: 4px;
    height: 100%;

    background: #abd600;

    transform: scaleY(0);
    transform-origin: bottom;

    transition: transform 0.3s ease;
}


:global(.blog-feature-card:hover) {
    transform: translateY(-7px);

    border-color: #abd600;

    box-shadow:
        0 18px 40px rgba(0, 0, 0, 0.12);
}


:global(.blog-feature-card:hover::before) {
    transform: scaleY(1);
}


/* =========================================
   ICONOS
========================================= */

:global(.blog-feature-icon) {
    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

