---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="TechNexus - Contacto"
  description="Nuestro equipo de expertos está listo para transformar tu infraestructura corporativa. Contáctanos para discutir tu próximo gran proyecto."
  activeNav="contacto"
>
  <main class="flex-grow pt-[120px] pb-section-gap px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto w-full">
    <!-- Hero Section -->
    <section class="text-center mb-section-gap">
      <h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-background mb-stack-md">
        Iniciemos algo <span class="text-primary-fixed">increíble</span>
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Nuestro equipo de expertos está listo para transformar tu infraestructura corporativa. Contáctanos para discutir tu próximo gran proyecto.
      </p>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <!-- Contact Form -->
      <div class="md:col-span-7 bg-surface-container-low rounded-xl border border-surface-variant p-stack-lg relative overflow-hidden backdrop-blur-xl">
        <!-- Subtle gradient accent -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary-fixed to-transparent opacity-50"></div>
        <h2 class="font-headline-md text-headline-md text-on-background mb-stack-lg">Envíanos un mensaje</h2>
        
        <form class="space-y-stack-md" id="contact-form">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-md">
            <div>
              <label class="block font-label-caps text-label-caps text-on-surface-variant mb-stack-sm" for="name">Nombre Completo</label>
              <input class="w-full bg-surface-dim border border-surface-variant rounded-lg px-4 py-3 text-on-background focus:outline-none focus:border-primary-fixed focus:ring-1 focus:ring-primary-fixed transition-colors" id="name" placeholder="Ej. Juan Pérez" type="text" />
            </div>
            <div>
              <label class="block font-label-caps text-label-caps text-on-surface-variant mb-stack-sm" for="email">Correo Electrónico</label>
              <input class="w-full bg-surface-dim border border-surface-variant rounded-lg px-4 py-3 text-on-background focus:outline-none focus:border-primary-fixed focus:ring-1 focus:ring-primary-fixed transition-colors" id="email" placeholder="juan@empresa.com" type="email" />
            </div>
          </div>
          <div>
            <label class="block font-label-caps text-label-caps text-on-surface-variant mb-stack-sm" for="company">Empresa</label>
            <input class="w-full bg-surface-dim border border-surface-variant rounded-lg px-4 py-3 text-on-background focus:outline-none focus:border-primary-fixed focus:ring-1 focus:ring-primary-fixed transition-colors" id="company" placeholder="Nombre de tu empresa" type="text" />
          </div>
          <div>
            <label class="block font-label-caps text-label-caps text-on-surface-variant mb-stack-sm" for="project">Detalles del Proyecto</label>
            <textarea class="w-full bg-surface-dim border border-surface-variant rounded-lg px-4 py-3 text-on-background focus:outline-none focus:border-primary-fixed focus:ring-1 focus:ring-primary-fixed transition-colors resize-none" id="project" placeholder="Describe brevemente tus necesidades tecnológicas..." rows="4"></textarea>
          </div>
          <button class="w-full md:w-auto bg-primary-fixed text-on-primary-fixed font-label-caps text-label-caps px-8 py-4 rounded-lg hover:bg-primary-fixed/90 transition-colors shadow-[0_0_15px_rgba(195,244,0,0.2)] mt-stack-md flex items-center justify-center gap-2" type="submit">
            <span>Enviar Mensaje</span>
            <span class="material-symbols-outlined text-[18px]">send</span>
          </button>
        </form>
      </div>

      <!-- Direct Channels & Location -->
      <div class="md:col-span-5 flex flex-col gap-gutter">
        <!-- Direct Channels Card -->
        <div class="bg-surface-container-low rounded-xl border border-surface-variant p-stack-lg">
          <h3 class="font-headline-sm text-headline-sm text-on-background mb-stack-md">Canales Directos</h3>
          <p class="font-body-md text-body-md text-on-surface-variant mb-stack-lg">¿Necesitas una respuesta inmediata? Utiliza nuestros canales directos de comunicación.</p>
          <div class="space-y-stack-md">
            <a class="flex items-center justify-center gap-3 w-full border border-surface-variant bg-surface-dim hover:bg-surface-variant/50 text-on-background font-label-caps text-label-caps px-6 py-4 rounded-lg transition-all hover:border-primary-fixed group" href="https://wa.me/593988519822?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20sus%20servicios." target="_blank" rel="noopener noreferrer">
              <span class="material-symbols-outlined text-[#25D366] group-hover:scale-110 transition-transform">chat</span>
              <span>Escríbenos por WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Location Card -->
        <div class="bg-surface-container-low rounded-xl border border-surface-variant p-stack-lg flex-grow flex flex-col">
          <h3 class="font-headline-sm text-headline-sm text-on-background mb-stack-md">Nuestras Oficinas</h3>
          <div class="flex items-start gap-4 mb-stack-md">
            <span class="material-symbols-outlined text-primary-fixed mt-1">location_on</span>
            <div>
              <p class="font-label-caps text-label-caps text-on-background mb-1">Sede Central</p>
              <p class="font-body-md text-body-md text-on-surface-variant">Av. de la Innovación 101, Piso 24<br/>Distrito Tecnológico, Ciudad M<br/>CP 28040</p>
            </div>
          </div>
          <div class="mt-auto rounded-lg overflow-hidden border border-surface-variant h-48 relative grayscale hover:grayscale-0 transition-all duration-500">
            <img class="w-full h-full object-cover" alt="Mapa de sede central" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-HUehQ3bU_o5nADvCCO1Nd7KS4YMs0CbpE8N0yGdD3zAw2CqNmSzKy9eoRo50eJPTbztol4LiBCNdGK-_yIvy4K7SagXq3H0Ypw3LTomfAwAtlE6N6OCgQ5bYuJ-00jke2FYCo1MfhSGAnTBHaQmaND_-gkAInakO2_XFdhMLruQ-viz819IHbGnnatShIAz_AACvXKUuRiZuPeCOmYy3V--jcs-PioDqoHWNQoQgm8OsjCr8Z4tNNQ"/>
            <div class="absolute inset-0 bg-background/20 pointer-events-none"></div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  (function () {
    var form = document.getElementById("contact-form");
    if (!form) {
      return;
    }

    var whatsappNumber = "593988519822";

    form.addEventListener("submit", function (event) {
      event.preventDefault();

      var name = ((document.getElementById("name") as HTMLInputElement).value || "").trim();
      var email = ((document.getElementById("email") as HTMLInputElement).value || "").trim();
      var company = ((document.getElementById("company") as HTMLInputElement).value || "").trim();
      var project = ((document.getElementById("project") as HTMLTextAreaElement).value || "").trim();

      var message = [
        "Hola, me gustaría solicitar información:",
        "",
        "Nombre: " + (name || "No especificado"),
        "Correo: " + (email || "No especificado"),
        "Empresa: " + (company || "No especificado"),
        "Proyecto: " + (project || "No especificado")
      ].join("\n");

      var whatsappUrl = "https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(message);
      window.open(whatsappUrl, "_blank", "noopener,noreferrer");
    });
  })();
</script>
